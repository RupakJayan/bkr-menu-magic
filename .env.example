# BKR Menu Magic - Environment Variables
# Copy this file to .env.local to configure Google integrations for your local and production builds.

# 1. Google OAuth 2.0 Web Client ID (for Sign in with Google & Google Drive storage)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript Origins: https://rupakjayan.github.io and http://localhost:8080
VITE_GOOGLE_CLIENT_ID=

# 2. Google Maps API Key (for Places Autocomplete & venue location picker)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> API Keys
# Enabled APIs: Places API, Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=
